# Finora — local and hosted environment configuration.
# Copy to .env for local development. Never commit real values.
# Vercel: add secrets under Project Settings > Environment Variables.

# Local development may use SQLite. Hosted Vercel deployments REQUIRE
# DATABASE_URL: serverless local files are not durable.
FLASK_ENV=development
DATABASE_URL=sqlite:///finora.db
SECRET_KEY=replace-with-a-random-32-byte-secret
PREFERRED_URL_SCHEME=http

# Hosted configuration (set in Vercel, not in your repository):
# FLASK_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/finora?sslmode=require
# PREFERRED_URL_SCHEME=https

# Google Sign-In (optional; authorize the exact /auth/google/callback URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Verification and password-reset emails.
# Preferred option: Resend HTTPS API (no background worker required).
RESEND_API_KEY=
EMAIL_FROM=Finora <no-reply@your-verified-domain.example>

# Alternative: authenticated SMTP over TLS. Useful with Gmail App Passwords.
# Port 587: STARTTLS. Port 465: implicit TLS.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER is legacy; the app uses the Finora brand plus MAIL_USERNAME.
